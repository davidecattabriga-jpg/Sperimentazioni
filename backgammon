<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<title>Backgammon</title>
<style>
  * { box-sizing: border-box; }
  body { 
    margin: 0; 
    padding: 10px; 
    background: #2c3e50; 
    color: #fff; 
    font-family: sans-serif; 
    text-align: center; 
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    overflow: hidden;
  }
  .header { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    padding: 10px 15px; 
    background: #1a252f; 
    border-radius: 6px 6px 0 0; 
    width: 720px; 
  }
  button { 
    padding: 6px 14px; 
    background: #e74c3c; 
    color: white; 
    border: none; 
    border-radius: 4px; 
    cursor: pointer; 
    font-weight: bold; 
  }
  button:disabled { background: #7f8c8d; cursor: not-allowed; }
  canvas { 
    border: 3px solid #1a252f; 
    border-top: none; 
    border-radius: 0 0 4px 4px; 
    background: #3e2723; 
    display: block; 
    margin: 0 auto; 
    cursor: pointer; 
  }
</style>
</head>
<body>

<div class="header">
  <div id="status" style="font-size: 13px; font-weight: bold;">Tocca al BIANCO. Clicca "Lancia Dadi"!</div>
  <button id="roll-btn">LANCIA DADI</button>
</div>

<canvas id="cvs" width="720" height="450"></canvas>

<script>
var canvas = document.getElementById('cvs');
var ctx = canvas.getContext('2d');

var board = [
  -2,  0,  0,  0,  0,  5,   0,  3,  0,  0,  0, -5,  
   5,  0,  0,  0, -3,  0,  -5,  0,  0,  0,  0,  2   
];

var barWhite = 0;
var barBlack = 0;
var borneOffWhite = 0;
var borneOffBlack = 0;

var turn = 'white';
var dice = [];
var selectedPoint = null;
var message = "Tocca al BIANCO. Clicca 'Lancia Dadi'!";

var botHighlightFrom = null;
var botHighlightTo = null;

function drawBoard() {
  ctx.fillStyle = '#3e2723';
  ctx.fillRect(0, 0, 720, 450);

  ctx.fillStyle = '#1a252f';
  ctx.fillRect(0, 0, 25, 450);
  ctx.fillRect(695, 0, 25, 450);
  ctx.fillRect(345, 0, 30, 450);

  var tw = 52;

  for (var i = 0; i < 12; i++) {
    var x = 25 + i * tw + (i >= 6 ? 30 : 0);
    ctx.fillStyle = (i % 2 === 0) ? '#d35400' : '#ecf0f1';
    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x + tw/2, 180); ctx.lineTo(x + tw, 0); ctx.fill();
  }

  for (var i = 0; i < 12; i++) {
    var x = 25 + i * tw + (i >= 6 ? 30 : 0);
    ctx.fillStyle = (i % 2 === 0) ? '#ecf0f1' : '#d35400';
    ctx.beginPath(); ctx.moveTo(x, 450); ctx.lineTo(x + tw/2, 270); ctx.lineTo(x + tw, 450); ctx.fill();
  }

  if (selectedPoint !== null) highlightPoint(selectedPoint, 'rgba(46, 204, 113, 0.4)');
  if (botHighlightFrom !== null) highlightPoint(botHighlightFrom, 'rgba(231, 76, 60, 0.6)');
  if (botHighlightTo !== null) highlightPoint(botHighlightTo, 'rgba(231, 76, 60, 0.6)');

  for (var p = 0; p < 24; p++) {
    var count = board[p];
    if (count !== 0) {
      var isWhite = count > 0;
      var num = Math.abs(count);
      var pIdx = (p >= 12) ? (p - 12) : (11 - p);
      var px = 25 + pIdx * tw + (pIdx >= 6 ? 30 : 0) + tw / 2;
      var top = (p >= 12);
      for (var j = 0; j < num; j++) {
        var py = top ? (16 + j * 24) : (434 - j * 24);
        drawChecker(px, py, isWhite);
      }
    }
  }

  for (var w = 0; w < barWhite; w++) drawChecker(360, 300 + w * 22, true);
  for (var b = 0; b < barBlack; b++) drawChecker(360, 150 - b * 22, false);

  if (dice.length > 0) {
    ctx.fillStyle = 'rgba(0, 0, 0, 0.7)';
    ctx.fillRect(260, 205, 200, 40);
    ctx.fillStyle = '#fff';
    ctx.font = 'bold 14px sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText("Dadi: " + dice.join(" - ") + " | Out B:" + borneOffWhite + " N:" + borneOffBlack, 360, 230);
  }

  document.getElementById('status').textContent = message;
  document.getElementById('roll-btn').disabled = (turn === 'black' || dice.length > 0);
}

function highlightPoint(pt, color) {
  var tw = 52;
  var x;
  if (pt >= 12) {
    var idx = pt - 12;
    x = 25 + idx * tw + (idx >= 6 ? 30 : 0);
    ctx.fillStyle = color;
    ctx.fillRect(x, 0, tw, 180);
  } else {
    var idx = 11 - pt;
    x = 25 + idx * tw + (idx >= 6 ? 30 : 0);
    ctx.fillStyle = color;
    ctx.fillRect(x, 270, tw, 180);
  }
}

function drawChecker(x, y, isWhite) {
  ctx.beginPath();
  ctx.arc(x, y, 11, 0, Math.PI * 2);
  ctx.fillStyle = isWhite ? '#ffffff' : '#222222';
  ctx.fill();
  ctx.lineWidth = 1.5;
  ctx.strokeStyle = isWhite ? '#95a5a6' : '#000000';
  ctx.stroke();
}

function getClickedPoint(cx, cy) {
  var tw = 52;
  if (cx >= 345 && cx <= 375) return -1;
  for (var i = 0; i < 12; i++) {
    var x = 25 + i * tw + (i >= 6 ? 30 : 0);
    if (cx >= x && cx <= x + tw) {
      return (cy < 225) ? (12 + i) : (11 - i);
    }
  }
  return null;
}

document.getElementById('roll-btn').onclick = function() {
  if (turn !== 'white' || dice.length > 0) return;
  rollDice();
};

function rollDice() {
  botHighlightFrom = null;
  botHighlightTo = null;
  var d1 = Math.floor(Math.random() * 6) + 1;
  var d2 = Math.floor(Math.random() * 6) + 1;
  dice = (d1 === d2) ? [d1, d1, d1, d1] : [d1, d2];
  selectedPoint = null;

  if (turn === 'white') {
    message = "Dadi: " + dice.join(",") + ". Muovi una pedina bianca.";
    checkWhiteHasLegalMoves();
  } else {
    message = "Il Bot (NERO) sta muovendo...";
  }
  drawBoard();

  if (turn === 'black') {
    setTimeout(playBotTurn, 800);
  }
}

function whiteCanBearOff() {
  if (barWhite > 0) return false;
  for (var i = 6; i < 24; i++) {
    if (board[i] > 0) return false;
  }
  return true;
}

// Verifica se la pedina selezionata è la più lontana rimasta nella casa del Bianco (punte 0..5)
function isFarthestWhite(pt) {
  for (var i = 5; i > pt; i--) {
    if (board[i] > 0) return false;
  }
  return true;
}

function checkWhiteHasLegalMoves() {
  if (dice.length === 0) return;
  
  // Se ci sono pedine al bar
  if (barWhite > 0) {
    for (var i = 0; i < dice.length; i++) {
      var target = 23 - (dice[i] - 1);
      if (board[target] >= -1) return; // Mossa legale presente
    }
    message = "Nessun rientro possibile dal Bar per il Bianco. Turno passato!";
    dice = [];
    setTimeout(checkTurnEnd, 1200);
    return;
  }

  // Se siamo in Bear Off
  if (whiteCanBearOff()) {
    for (var p = 0; p <= 5; p++) {
      if (board[p] > 0) {
        var req = p + 1;
        for (var d = 0; d < dice.length; d++) {
          if (dice[d] === req || (dice[d] > req && isFarthestWhite(p))) return; // Mossa legale
          if (p - dice[d] >= 0 && board[p - dice[d]] >= -1) return;
        }
      }
    }
  } else {
    // Mosse standard
    for (var p = 0; p < 24; p++) {
      if (board[p] > 0) {
        for (var d = 0; d < dice.length; d++) {
          var target = p - dice[d];
          if (target >= 0 && board[target] >= -1) return;
        }
      }
    }
  }

  message = "Nessuna mossa valida per il Bianco. Turno passato!";
  dice = [];
  setTimeout(checkTurnEnd, 1200);
}

canvas.addEventListener('click', function(e) {
  if (turn !== 'white' || dice.length === 0) return;

  var rect = canvas.getBoundingClientRect();
  var cx = e.clientX - rect.left;
  var cy = e.clientY - rect.top;
  var pt = getClickedPoint(cx, cy);

  if (pt === null) return;

  // Gestione Rientro dal Bar
  if (barWhite > 0) {
    for (var i = 0; i < dice.length; i++) {
      var target = 23 - (dice[i] - 1);
      if (pt === target && board[pt] >= -1) {
        barWhite--;
        if (board[pt] === -1) { board[pt] = 1; barBlack++; }
        else { board[pt]++; }
        dice.splice(i, 1);
        checkTurnEnd();
        drawBoard();
        return;
      }
    }
    message = "Impossibile rientrare dal Bar con questi dadi!";
    drawBoard();
    return;
  }

  if (selectedPoint === null) {
    if (board[pt] > 0) {
      selectedPoint = pt;
      message = "Punta " + (pt + 1) + " selezionata.";
    } else {
      message = "Non ci sono tue pedine qui!";
    }
  } else {
    // Se riclicca sulla pedina già selezionata in modalità Bear Off, prova l'uscita diretta!
    if (pt === selectedPoint && whiteCanBearOff()) {
      var needed = selectedPoint + 1;
      var exactIdx = dice.indexOf(needed);
      var usedDiceIdx = -1;

      if (exactIdx !== -1) {
        usedDiceIdx = exactIdx;
      } else if (isFarthestWhite(selectedPoint)) {
        // Cerca il dado più piccolo ma sufficiente per farla uscire
        for (var d = 0; d < dice.length; d++) {
          if (dice[d] > needed) { usedDiceIdx = d; break; }
        }
      }

      if (usedDiceIdx !== -1) {
        board[selectedPoint]--;
        dice.splice(usedDiceIdx, 1);
        borneOffWhite++;
        selectedPoint = null;
        message = "Pedina bianca uscita! Totale: " + borneOffWhite;
        if (borneOffWhite === 15) {
          alert("COMPLIMENTI, HAI VINTO! 🎉");
          location.reload();
        }
        checkTurnEnd();
        drawBoard();
        return;
      }
    }

    if (pt === selectedPoint) {
      selectedPoint = null;
      message = "Selezione annullata.";
    } else {
      var dist = selectedPoint - pt;
      var dIdx = dice.indexOf(dist);

      if (dIdx !== -1 && dist > 0 && board[pt] >= -1) {
        board[selectedPoint]--;
        if (board[pt] === -1) {
          board[pt] = 1;
          barBlack++;
          message = "Hai mangiato una pedina nera!";
        } else {
          board[pt]++;
        }
        dice.splice(dIdx, 1);
        selectedPoint = null;
        checkTurnEnd();
      } else {
        // Tentativo di uscita cliccando all'esterno o verso la direzione di casa
        if (whiteCanBearOff() && pt < selectedPoint) {
          var needed = selectedPoint + 1;
          var exactIdx = dice.indexOf(needed);
          var usedDiceIdx = -1;

          if (exactIdx !== -1) {
            usedDiceIdx = exactIdx;
          } else if (isFarthestWhite(selectedPoint)) {
            for (var d = 0; d < dice.length; d++) {
              if (dice[d] > needed) { usedDiceIdx = d; break; }
            }
          }

          if (usedDiceIdx !== -1) {
            board[selectedPoint]--;
            dice.splice(usedDiceIdx, 1);
            borneOffWhite++;
            selectedPoint = null;
            message = "Pedina bianca uscita! Totale: " + borneOffWhite;
            if (borneOffWhite === 15) {
              alert("COMPLIMENTI, HAI VINTO! 🎉");
              location.reload();
            }
            checkTurnEnd();
            drawBoard();
            return;
          }
        }
        message = "Mossa non valida!";
        selectedPoint = null;
      }
    }
  }
  drawBoard();
});

function checkTurnEnd() {
  if (dice.length === 0) {
    turn = 'black';
    message = "Turno del Bot (NERO)...";
    drawBoard();
    setTimeout(rollDice, 1000);
  } else {
    message = "Mossa OK! Dadi rimanenti: " + dice.join(", ");
    checkWhiteHasLegalMoves();
  }
}

function playBotTurn() {
  if (dice.length === 0) {
    turn = 'white';
    botHighlightFrom = null;
    botHighlightTo = null;
    message = "Il Bot ha finito. Tocca al BIANCO!";
    drawBoard();
    return;
  }

  var moved = false;

  if (barBlack > 0) {
    for (var i = 0; i < dice.length; i++) {
      var target = dice[i] - 1;
      if (board[target] <= 1) {
        barBlack--;
        if (board[target] === 1) { board[target] = -1; barWhite++; }
        else { board[target]--; }
        dice.splice(i, 1);
        botHighlightFrom = null;
        botHighlightTo = target;
        message = "Il Bot fa rientrare una pedina dal Bar!";
        moved = true;
        break;
      }
    }
  } else {
    outerLoop:
    for (var p = 23; p >= 0; p--) {
      if (board[p] < 0) {
        for (var i = 0; i < dice.length; i++) {
          var target = p + dice[i];
          if (target < 24 && board[target] <= 1) {
            board[p]++;
            if (board[target] === 1) {
              board[target] = -1;
              barWhite++;
            } else {
              board[target]--;
            }
            dice.splice(i, 1);
            botHighlightFrom = p;
            botHighlightTo = target;
            message = "Il Bot muove dalla punta " + (p + 1) + " alla " + (target + 1);
            moved = true;
            break outerLoop;
          }
        }
      }
    }
  }

  if (!moved) {
    dice = [];
    turn = 'white';
    botHighlightFrom = null;
    botHighlightTo = null;
    message = "Il Bot non può muovere. Tocca al BIANCO!";
    drawBoard();
    return;
  }

  drawBoard();

  if (dice.length > 0) {
    setTimeout(playBotTurn, 900);
  } else {
    setTimeout(function() {
      turn = 'white';
      botHighlightFrom = null;
      botHighlightTo = null;
      message = "Il Bot ha completato il turno. Tocca a te (BIANCO)!";
      drawBoard();
    }, 900);
  }
}

drawBoard();
</script>

</body>
</html>

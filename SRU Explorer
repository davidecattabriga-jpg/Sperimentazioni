<div id="biblio-lab" style="font-family: system-ui, sans-serif; max-width: 650px; margin: 20px auto;">
    <div style="display: flex; gap: 10px; margin-bottom: 30px;">
        <input type="text" id="biblio-query" placeholder="Search for a book, e.g., Shakespeare, Homer, Divine Comedy..." style="flex: 1; padding: 12px 15px; font-size: 16px; border: 1px solid #ddd; border-radius: 6px; outline: none;">
        <button id="biblio-btn" style="padding: 12px 24px; font-size: 16px; background: #111; color: #fff; border: none; border-radius: 6px; cursor: pointer;">Search</button>
    </div>
    <div id="biblio-results"></div>
</div>

<script>
document.getElementById('biblio-btn').addEventListener('click', performSearch);
document.getElementById('biblio-query').addEventListener('keypress', function (e) {
    if (e.key === 'Enter') performSearch();
});

async function performSearch() {
    const query = document.getElementById('biblio-query').value.trim();
    const resultsDiv = document.getElementById('biblio-results');
    if (!query) return;

    resultsDiv.innerHTML = '<p style="color: #666; font-style: italic;">Querying catalog...</p>';

    try {
        const response = await fetch(`https://openlibrary.org/search.json?q=${encodeURIComponent(query)}`);
        const data = await response.json();
        const docs = data.docs.slice(0, 5); // Showing the first 5 results

        if (docs.length === 0) {
            resultsDiv.innerHTML = '<p>No records found in the catalog.</p>';
            return;
        }

        let html = '';
        docs.forEach(doc => {
            const title = doc.title || 'Unknown title';
            const author = doc.author_name ? doc.author_name.join(', ') : 'Author not specified';
            const year = doc.first_publish_year || 'N/A';

            html += `
                <div style="background: #fafafa; border-left: 3px solid #111; padding: 15px; margin-bottom: 15px; border-radius: 0 4px 4px 0;">
                    <h4 style="margin: 0 0 6px 0; font-size: 18px; color: #111;">${title}</h4>
                    <p style="margin: 0 0 4px 0; color: #444; font-size: 15px;"><strong>Author:</strong> ${author}</p>
                    <p style="margin: 0; color: #777; font-size: 13px;"><strong>Year:</strong> ${year}</p>
                </div>
            `;
        });
        resultsDiv.innerHTML = html;
    } catch (error) {
        resultsDiv.innerHTML = '<p style="color: red;">Communication error with the cataloging service.</p>';
    }
}
</script>
